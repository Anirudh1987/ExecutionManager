# ExecutionManager Configuration
# Copy this file to .env and fill in your values

# Anthropic API key — required for AI clause analysis, risk detection, and advisory generation
# Without this, the app runs but all AI features are disabled
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Storage backend: "1" for SQLite (persistent), "0" for in-memory (lost on restart)
USE_SQLITE=1

# SQLite database file path (only used when USE_SQLITE=1)
DB_PATH=executionmanager.db

# Authentication: "1" to require login, "0" for open access (dev mode)
AUTH_REQUIRED=0

# JWT secret key for auth tokens (change this in production!)
JWT_SECRET_KEY=change-me-in-production

# JWT token expiry in hours
TOKEN_EXPIRE_HOURS=12
